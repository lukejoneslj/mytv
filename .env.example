# Copy to .env (setup.sh does this for you). Every value is optional.

# Where MyTV listens. 0.0.0.0 lets the Apple TV reach it.
MYTV_HOST=0.0.0.0
MYTV_PORT=8400

# Database, video cache, posters, logs. Relative paths are relative to this folder.
MYTV_DATA_DIR=data

# Your own media. Originals here are never modified or deleted.
MYTV_LIBRARY_DIR=library

# Force the address written into the playlist, e.g. http://my-mac.local:8400
# Leave empty to use whatever address the player connected with.
MYTV_PUBLIC_URL=

# Optional: better posters and descriptions (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Set to false to allow dashboard changes only from this Mac.
MYTV_ADMIN_FROM_LAN=true

# Only if ffmpeg is not on PATH or in /opt/homebrew/bin
FFMPEG_PATH=
FFPROBE_PATH=
